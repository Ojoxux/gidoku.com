{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".wrangler/**",
    ".codex/**",
    ".claude/**",
    "worker-configuration.d.ts",
    "pnpm-lock.yaml",
    "*.md",
    "public/icons/**"
  ]
}
